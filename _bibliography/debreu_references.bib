@inproceedings{lemarie:hal-03769267,
  TITLE = {{Stability and accuracy of Runge-Kutta based split-explicit time-stepping algorithms for free-surface ocean models}},
  AUTHOR = {Lemari{\'e}, Florian and Ducousso, Nicolas and Debreu, Laurent and Madec, Gurvan},
